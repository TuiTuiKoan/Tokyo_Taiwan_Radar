{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "source_name",
    "class_name",
    "base_url",
    "search_url",
    "card_selector",
    "field_selectors",
    "date_regex",
    "source_id_prefix",
    "source_id_url_pattern"
  ],
  "properties": {
    "source_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$"},
    "class_name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{1,40}$"},
    "base_url": {"type": "string", "pattern": "^https://"},
    "search_url": {"type": "string", "pattern": "^https://"},
    "search_keyword": {"type": "string", "default": "%E5%8F%B0%E6%B9%BE"},
    "max_pages": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5},
    "card_selector": {"type": "string", "minLength": 1},
    "detail_link_selector": {"type": "string", "default": ""},
    "field_selectors": {
      "type": "object",
      "required": ["title", "date"],
      "properties": {
        "title": {"type": "string"},
        "date": {"type": "string"},
        "description": {"type": "string"},
        "location": {"type": "string"},
        "image": {"type": "string"}
      },
      "additionalProperties": false
    },
    "date_regex": {"type": "string"},
    "source_id_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_$"},
    "source_id_url_pattern": {"type": "string"}
  },
  "additionalProperties": false
}
