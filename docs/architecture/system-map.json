  "dataFlow": [
    { "from": "scrapers", "to": "merger", "label": "raw events" },
    { "from": "merger", "to": "annotator", "label": "deduped events" },
    { "from": "annotator", "to": "movie_title_lookup", "label": "movie events" },
    { "from": "annotator", "to": "person_name_lookup", "label": "person names" },
    { "from": "annotator", "to": "supabase", "label": "annotated events" },
    { "from": "supabase", "to": "web", "label": "trilingual UI" },
    { "from": "auto_qa", "to": "event_reports", "label": "auto findings" },
    { "from": "event_reports", "to": "admin_reports", "label": "admin review" }
  ],
  "actions": [
    {
      "id": "invite-new-user",
      "label": "Invite new user",
      "description": "Admin checks user roles and current auth users list via RPC."
    },
    {
      "id": "todesktop-build",
      "label": "ToDesktop build",
      "description": "Desktop build and release trigger is modeled as an external/manual flow."
    },
    {
      "id": "run-scraper-now",
      "label": "Run scraper now",
      "description": "Admin triggers scrape-now workflow_dispatch with optional source list."
    },
    {
      "id": "annotate-event",
      "label": "Annotate event",
      "description": "Admin triggers enrich-and-annotate for one event or annotate-now for pending queue."
    },
    {
      "id": "weekly-line-broadcast",
      "label": "Weekly LINE broadcast",
      "description": "Generate/send weekly announcements through admin API and scheduled workflow."
    },
    {
      "id": "create-announcement",
      "label": "Create announcement",
      "description": "Admin creates announcements and optional event links in Supabase tables."
    },
    {
      "id": "ai-correction-feedback-loop",
      "label": "AI correction feedback loop",
      "description": "Admin report confirmations persist corrections that annotator reuses in future runs."
    }
  ],
  "flows": [
    {
      "id": "invite-new-user",
      "actionId": "invite-new-user",
      "title": "Invite new user",
      "steps": [
        {
          "from": "web/app/[locale]/admin/users/page.tsx",
          "to": "db:user_roles",
          "channel": "Supabase query",
          "payloadNote": "session user_id -> role must be admin",
          "evidenceRef": "web/app/[locale]/admin/users/page.tsx"
        },
        {
          "from": "web/app/[locale]/admin/users/page.tsx",
          "to": "db:rpc/admin_list_users",
          "channel": "Supabase RPC",
          "payloadNote": "RPC output: id, email, created_at, last_sign_in_at, role",
          "evidenceRef": "web/app/[locale]/admin/users/page.tsx"
        },
        {
          "from": "db:rpc/admin_list_users",
          "to": "web/app/[locale]/admin/users/page.tsx",
          "channel": "SSR render",
          "payloadNote": "Admin users table/card view",
          "evidenceRef": "web/app/[locale]/admin/users/page.tsx"
        }
      ],
      "annotations": [
        "Current repo evidence covers listing/admin-role validation via admin_list_users RPC.",
        "User invitation itself may happen outside this page (Auth dashboard/manual flow)."
      ]
    },
    {
      "id": "todesktop-build",
      "actionId": "todesktop-build",
      "title": "ToDesktop build",
      "steps": [
        {
          "from": "external:release-manager",
          "to": "external:todesktop-build-trigger",
          "channel": "manual trigger",
          "payloadNote": "version, release notes, signing profile",
          "evidenceRef": "No *.yml workflow with 'todesktop' found under .github/workflows"
        },
        {
          "from": "external:todesktop-build-trigger",
          "to": "external:desktop-artifact-distribution",
          "channel": "external pipeline",
          "payloadNote": "installer artifact + release metadata",
          "evidenceRef": "Modeled as external/manual until in-repo workflow evidence is added"
        }
      ],
      "annotations": [
        "This flow is intentionally modeled as external/manual and does not block current delivery.",
        "Add concrete workflow and node evidence later when ToDesktop CI is added into this repo."
      ]
    },
    {
      "id": "run-scraper-now",
      "actionId": "run-scraper-now",
      "title": "Run scraper now",
      "steps": [
        {
          "from": "web/components/AdminSourcesTable.tsx",
          "to": "web/app/api/admin/scrape-now/route.ts",
          "channel": "POST /api/admin/scrape-now",
          "payloadNote": "{ sources: string[] } (empty means run all)",
          "evidenceRef": "web/components/AdminSourcesTable.tsx"
        },
        {
          "from": "web/app/api/admin/scrape-now/route.ts",
          "to": ".github/workflows/scrape-now.yml",
          "channel": "GitHub workflow_dispatch",
          "payloadNote": "inputs.sources as space-separated names",
          "evidenceRef": "web/app/api/admin/scrape-now/route.ts"
        },
        {
          "from": ".github/workflows/scrape-now.yml",
          "to": "scraper/main.py",
          "channel": "Python CLI",
          "payloadNote": "python main.py [--source ...]",
          "evidenceRef": ".github/workflows/scrape-now.yml"
        },
        {
          "from": "scraper/main.py",
          "to": "db:events",
          "channel": "Supabase upsert",
          "payloadNote": "scraped + merged + annotated events",
          "evidenceRef": "scraper/main.py"
        }
      ],
      "annotations": [
        "Role gate is enforced in API route via user_roles.",
        "Workflow accepts source list input and falls back to full run when empty."
      ]
    },
    {
      "id": "annotate-event",
      "actionId": "annotate-event",
      "title": "Annotate event",
      "steps": [
        {
          "from": "web/app/[locale]/admin/[id]/page.tsx",
          "to": "web/app/api/admin/enrich-and-annotate/route.ts",
          "channel": "POST /api/admin/enrich-and-annotate",
          "payloadNote": "{ eventId }",
          "evidenceRef": "web/app/api/admin/enrich-and-annotate/route.ts"
        },
        {
          "from": "web/app/api/admin/enrich-and-annotate/route.ts",
          "to": ".github/workflows/enrich-and-annotate.yml",
          "channel": "GitHub workflow_dispatch",
          "payloadNote": "inputs.event_id",
          "evidenceRef": "web/app/api/admin/enrich-and-annotate/route.ts"
        },
        {
          "from": ".github/workflows/enrich-and-annotate.yml",
          "to": "scraper/enrich_ocr_event.py",
          "channel": "Step 1",
          "payloadNote": "enrich OCR-created event",
          "evidenceRef": ".github/workflows/enrich-and-annotate.yml"
        },
        {
          "from": ".github/workflows/enrich-and-annotate.yml",
          "to": "scraper/annotator.py",
          "channel": "Step 2",
          "payloadNote": "annotate pending events",
          "evidenceRef": ".github/workflows/enrich-and-annotate.yml"
        },
        {
          "from": "scraper/annotator.py",
          "to": "db:events",
          "channel": "Supabase update",
          "payloadNote": "annotation_status transition pending -> annotated/reviewed",
          "evidenceRef": "scraper/annotator.py"
        }
      ],
      "annotations": [
        "For queue-wide run, admin can also dispatch annotate-now workflow.",
        "Per-event path is modeled with enrich-and-annotate workflow for stronger evidence linkage."
      ]
    },
    {
      "id": "weekly-line-broadcast",
      "actionId": "weekly-line-broadcast",
      "title": "Weekly LINE broadcast",
      "steps": [
        {
          "from": "web/components/WeeklyBroadcastPanel.tsx",
          "to": "web/app/api/admin/weekly-broadcast/route.ts",
          "channel": "GET/PATCH",
          "payloadNote": "read/write app_settings.weekly_broadcast.auto_publish",
          "evidenceRef": "web/components/WeeklyBroadcastPanel.tsx"
        },
        {
          "from": "web/components/WeeklyBroadcastPanel.tsx",
          "to": "web/app/api/admin/weekly-broadcast/send/route.ts",
          "channel": "POST",
          "payloadNote": "{ id } announcement draft id",
          "evidenceRef": "web/components/WeeklyBroadcastPanel.tsx"
        },
        {
          "from": "web/app/api/admin/weekly-broadcast/send/route.ts",
          "to": "db:line_subscribers",
          "channel": "Supabase read",
          "payloadNote": "language_preference groups for LINE multicast",
          "evidenceRef": "web/app/api/admin/weekly-broadcast/send/route.ts"
        },
        {
          "from": ".github/workflows/weekly-broadcast.yml",
          "to": "scraper/weekly_line_broadcast.py",
          "channel": "schedule/workflow_dispatch",
          "payloadNote": "generate-draft | auto-send | dry-run",
          "evidenceRef": ".github/workflows/weekly-broadcast.yml"
        },
        {
          "from": "scraper/weekly_line_broadcast.py",
          "to": "db:announcements",
          "channel": "Supabase upsert/update",
          "payloadNote": "create draft and update published_at/social_status",
          "evidenceRef": "scraper/weekly_line_broadcast.py"
        }
      ],
      "annotations": [
        "Panel supports both manual send and auto-publish toggle.",
        "Scheduled workflow covers Thursday draft generation and Friday auto-send."
      ]
    },
    {
      "id": "create-announcement",
      "actionId": "create-announcement",
      "title": "Create announcement",
      "steps": [
        {
          "from": "web/app/[locale]/admin/announcements/new/page.tsx",
          "to": "web/app/api/announcements/route.ts",
          "channel": "POST /api/announcements",
          "payloadNote": "announcement fields + linked_events[]",
          "evidenceRef": "web/app/api/announcements/route.ts"
        },
        {
          "from": "web/app/api/announcements/route.ts",
          "to": "db:announcements",
          "channel": "Supabase insert",
          "payloadNote": "insert announcement with social_status {}",
          "evidenceRef": "web/app/api/announcements/route.ts"
        },
        {
          "from": "web/app/api/announcements/route.ts",
          "to": "db:announcement_events",
          "channel": "Supabase insert",
          "payloadNote": "junction rows for linked events",
          "evidenceRef": "web/app/api/announcements/route.ts"
        }
      ],
      "annotations": [
        "API route requires admin role before creating any announcement.",
        "Public GET path only returns published records for non-admin users."
      ]
    },
    {
      "id": "ai-correction-feedback-loop",
      "actionId": "ai-correction-feedback-loop",
      "title": "AI correction feedback loop",
      "steps": [
        {
          "from": "db:event_reports",
          "to": "web/app/actions/confirm-report.ts",
          "channel": "Server Action",
          "payloadNote": "reportId, reportTypes, fieldCorrections, correctedSelectionReason",
          "evidenceRef": "web/app/actions/confirm-report.ts"
        },
        {
          "from": "web/app/actions/confirm-report.ts",
          "to": "db:field_corrections",
          "channel": "Supabase upsert",
          "payloadNote": "(event_id, field_name) corrected_value persisted as P1 guard",
          "evidenceRef": "web/app/actions/confirm-report.ts"
        },
        {
          "from": "web/app/actions/confirm-report.ts",
          "to": "db:category_corrections",
          "channel": "Supabase upsert",
          "payloadNote": "wrongCategory correction examples",
          "evidenceRef": "web/app/actions/confirm-report.ts"
        },
        {
          "from": "web/app/actions/confirm-report.ts",
          "to": "db:selection_reason_corrections",
          "channel": "Supabase upsert",
          "payloadNote": "selection_reason correction examples",
          "evidenceRef": "web/app/actions/confirm-report.ts"
        },
        {
          "from": "db:field_corrections",
          "to": "scraper/annotator.py",
          "channel": "Annotator startup load",
          "payloadNote": "protect corrected fields and inject feedback prompts",
          "evidenceRef": "scraper/annotator.py"
        },
        {
          "from": "scraper/annotator.py",
          "to": "db:events",
          "channel": "Supabase update",
          "payloadNote": "future re-annotation respects human corrections",
          "evidenceRef": "scraper/annotator.py"
        }
      ],
      "annotations": [
        "confirm-report writes both event_reports status and correction tables.",
        "annotator.py imports category_feedback and selection_reason_feedback at startup."
      ]
    }
  ]
}
